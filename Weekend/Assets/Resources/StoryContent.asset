  m_Name: StoryContent
  m_EditorClassIdentifier:
  dreamPages:
  - "\u6211\u53C8\u56DE\u5230\u4E86\u5C0F\u65F6\u5019\u3002\n\n\u7236\u6BCD\u7AD9\u5728\u8DEF\u8FB9\uFF0C\u4E89\u5435\u58F0\u50CF\u9694\u7740\u4E00\u5C42\u6C34\u4F20\u6765\u3002\u6211\u4E5F\u5728\u558A\uFF0C\u5374\u8BB0\u4E0D\u6E05\u81EA\u5DF1\u7A76\u7ADF\u5728\u4E89\u8FA9\u4EC0\u4E48\u3002"
  - "\u6CA1\u6709\u4EBA\u542C\u6211\u8BF4\u8BDD\u3002\n\n\u6211\u4F4E\u4E0B\u5934\uFF0C\u770B\u89C1\u811A\u8FB9\u9686\u8D77\u7684\u8681\u7A74\u3002\u7EC6\u5C0F\u7684\u8682\u8681\u6CBF\u7740\u5165\u53E3\u722C\u8FDB\u722C\u51FA\uFF0C\u4EFF\u4F5B\u6211\u4EEC\u7684\u4E89\u5435\u4E0E\u5B83\u4EEC\u6BEB\u65E0\u5173\u7CFB\u3002"
  - "\u6211\u731B\u5730\u8E39\u4E86\u8FC7\u53BB\u3002\n\n\u571F\u5C51\u6563\u5F00\uFF0C\u8681\u7A74\u584C\u4E86\u3002\u8682\u8681\u5728\u6211\u7684\u978B\u8FB9\u56DB\u6563\u5954\u9003\u3002\u7236\u6BCD\u7684\u58F0\u97F3\u7A81\u7136\u8FDC\u53BB\uFF0C\u53EA\u5269\u4E0B\u6211\u6025\u4FC3\u7684\u547C\u5438\u3002"
  - "\u9ED1\u6697\u91CC\uFF0C\u6211\u50CF\u662F\u770B\u89C1\u4EC0\u4E48\u5E9E\u5927\u7684\u4E1C\u897F\u62AC\u8D77\u4E86\u811A\u3002\n\n\u6211\u731B\u7136\u60CA\u9192\u3002\u623F\u95F4\u5B89\u9759\u5F97\u53EF\u6015\uFF0C\u5FC3\u810F\u8FD8\u5728\u5267\u70C8\u8DF3\u52A8\u3002"
  ancientGodImageResource: Story/AncientGodRealistic
  discoveryText: "\u90A3\u4E0D\u662F\u4E91\uFF0C\u4E5F\u4E0D\u662F\u5C71\u3002\u661F\u5149\u6CBF\u7740\u4E00\u4E2A\u4E0D\u8BE5\u5B58\u5728\u7684\u8F6E\u5ED3\u5F2F\u6298\u3002\n\u6211\u7EC8\u4E8E\u660E\u767D\uFF0C\u5929\u7A7A\u540E\u9762\u8FD8\u6709\u67D0\u79CD\u6D3B\u7740\u7684\u4E1C\u897F\u3002"
  ancientGodTier: 2
  telescopePosition: {x: 2.3, y: -1.15}
  telescopeRange: 1.2
