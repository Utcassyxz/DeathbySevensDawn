  m_Name: FirstLoopPrologue
  m_EditorClassIdentifier: Assembly-CSharp::DeathBySeventhsDawn.Interaction.FirstLoopPrologueContent
  neighborPrefab: {fileID: 2748927396064221418, guid: 65f48d9c27f9bbb4d9d18a1ee0624705, type: 3}
  news: "\u672C\u53F0\u6D88\u606F\uFF1A\u4EE3\u53F7\u4E3A SKT-079 \u7684\u8D85\u65B0\u661F\u8109\u51B2\u9884\u8BA1\u5C06\u626B\u8FC7\u5730\u7403\uFF0C\u53EF\u80FD\u5E26\u6765\u4E0D\u540C\u7A0B\u5EA6\u7684\u7535\u5B50\u4FE1\u53F7\u6CE2\u52A8\u3002\u76F8\u5173\u89C2\u6D4B\u4ECD\u5728\u6301\u7EED\u3002\n\n\u64AD\u62A5\u58F0\u5FFD\u7136\u5931\u771F\uFF0C\u753B\u9762\u95EA\u8FC7\u4E00\u9053\u6A2A\u7EB9\u3002\n\n\u6211\u4E00\u76F4\u662F\u4E2A\u5929\u6587\u7231\u597D\u8005\u3002\u4ECA\u665A\uFF0C\u6211\u60F3\u7528\u9633\u53F0\u4E0A\u7684\u671B\u8FDC\u955C\u770B\u770B\u8FD9\u7247\u5929\u7A7A\u3002"
  flyer: "\u4F20\u5355\u4E0A\u7684\u5B57\u5199\u5F97\u5F88\u7528\u529B\uFF1A\n\n\u628A\u7A97\u6237\u906E\u8D77\u6765\u3002\u4E0D\u8981\u76F8\u4FE1\u90A3\u4E9B\u5E73\u9759\u7684\u58F0\u97F3\u3002\n\u5929\u4E0A\u6709\u4EC0\u4E48\u4E1C\u897F\u8981\u6765\u4E86\u3002"
  dayOneCaption: "401 \u7684\u4F4F\u6237\u6B63\u628A\u4E00\u5F20\u4F20\u5355\u8D34\u5728\u5899\u4E0A\uFF0C\u5634\u91CC\u4E0D\u4F4F\u5730\u5FF5\u7740\u4EC0\u4E48\u3002"
  startledCaption: "\u4ED6\u770B\u89C1\u4E86\u6211\u3002\n\u624B\u91CC\u7684\u52A8\u4F5C\u731B\u5730\u505C\u4F4F\uFF0C\u968F\u5373\u8F6C\u8EAB\u8DD1\u56DE\u4E86 401\u3002"
  boardingCaption: "401 \u7684\u602A\u4EBA\u6B63\u5728\u5F80\u95E8\u4E0A\u9489\u6728\u677F\u3002\n\u4ED6\u6CA1\u6709\u56DE\u7B54\u6211\uFF0C\u53EA\u628A\u6700\u540E\u4E00\u5757\u6728\u677F\u7262\u7262\u5C01\u5728\u95E8\u4E0A\u3002"
  chapterTitle: "\u5929\u7A79\u4E4B\u540E"
  chapterText: "\u6211\u539F\u672C\u53EA\u662F\u60F3\u89C2\u5BDF\u661F\u7A7A\u3002\n\n\u53EF\u6211\u770B\u5230\u7684\u4E0D\u662F\u4EFB\u4F55\u4E00\u79CD\u5929\u4F53\u3002\n\u90A3\u9053\u8F6E\u5ED3\u4E4B\u540E\uFF0C\u4F3C\u4E4E\u6709\u76EE\u5149\u6B63\u5728\u770B\u7740\u6211\u3002"
